<pj:UserControlBase x:Class="Dimension.DimensionUserControl"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:MichelleTool"
             xmlns:pj="clr-namespace:MichelleTool"
             mc:Ignorable="d" 
             xmlns:i="http://schemas.microsoft.com/xaml/behaviors"
             xmlns:sys="clr-namespace:System;assembly=mscorlib"
             Background="#f5f5f5"
             d:DesignHeight="350" Width="350">
    <i:Interaction.Triggers>
        <i:EventTrigger EventName="Loaded">
            <i:InvokeCommandAction Command="{Binding Loaded}" CommandParameter="{Binding RelativeSource={RelativeSource AncestorType=UserControl}}" />
        </i:EventTrigger>
    </i:Interaction.Triggers>
    <UserControl.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="pack://application:,,,/MichelleTool;component/Style/Styles.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </UserControl.Resources>
    <DockPanel Margin="{StaticResource mAll}">
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Margin="0 0 -10 -10" VerticalAlignment="Bottom">
            <Button Content="GEN_Cancel" Command="{Binding CancelCmd}" Style="{StaticResource CircleButton}" Margin="0"/>
            <Button Content="OK" Style="{StaticResource AcceptCircleButton}" Command="{Binding OKCmd}"/>
        </StackPanel>
        <Grid DockPanel.Dock="Top">
            <StackPanel>
                <TextBlock Text="Dimension"/>
                <ComboBox ItemsSource="{Binding itemDim}" SelectedItem="{Binding SelectedDim, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                <GroupBox Header="Dimension Options">
                    <StackPanel>
                        <CheckBox Margin="{StaticResource mTopLeft}" Content="Grid" IsChecked="{Binding Isgrid, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Margin="{StaticResource mTopLeft}" Content="Structural Column" IsChecked="{Binding IsStructuralColumn, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Margin="{StaticResource mTopLeft}" Content="Structural Framing" IsChecked="{Binding IsStructuralFraming, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Margin="{StaticResource mTopLeft}" Content="Structural Foundation" IsChecked="{Binding IsStructuralFoundation, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                        <CheckBox Margin="{StaticResource mTopLeft}" Content="Wall" IsChecked="{Binding IsWall, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                    </StackPanel>

                </GroupBox>
            </StackPanel>
        </Grid>
    </DockPanel>
</pj:UserControlBase>
